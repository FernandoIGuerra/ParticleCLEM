# ============================================================
#  CLEM 1D premixed flame -- CANONICAL CASE 2: ADVECTION + DIFFUSION
#  ============================================================
#  THIS IS THE INPUT FILE USED FOR THE "advection+diffusion" ANALYSIS.
#  Pairs with the pristine (unmodified PeleC) reference:
#    /home/fernando/FPCE/PeleC/Exec/RegTests/1DFlame/inputs-REF-DIFF.inp
#  which must be run with IDENTICAL physics (do_react=0, all
#  pelec.diffuse_* = 1) and produces ANALYSIS/pltDIF_XXXXX there.
#
#  Physics: Euler transport + full molecular diffusion (temp, enth,
#  spec, vel all on the LES) of the frozen flame profile - no reaction.
#  do_react=0 here is intentional and does NOT change the physics vs
#  do_react=1: when CLEM is active the LES reaction path is skipped
#  regardless of do_react (Advance.cpp: `!do_react || clem_active`
#  zeroes Reactions_Type either way) - kept =0 to match the reference
#  file exactly and remove any doubt.
#
#  CLEM strategy = CURRENT BEST-KNOWN CONFIG (2026-07-27), identical to
#  inputs-CLEM-ADV.inp EXCEPT clem.do_diffusion=1 (the subgrid LEM line
#  now also diffuses, mirroring the LES's pelec.diffuse_*=1):
#    clem.freeze_species     = 1   Maxwell: LES does NOT advect rho*Y_k
#    clem.pressure_coupling  = 1   LES->SGS isentropic pressure work
#    clem.couple_back        = 1   SGS->LES conserved-delta + projection
#    clem.couple_back_energy = 1   conserved rho*e delta (mode 1) - the
#                                  ONLY validated-safe energy mode
#    clem.vol_renorm         = 1   ensemble-volume renorm after splice
#    clem.do_diffusion       = 1   subgrid line diffusion ON (matches
#                                  pelec.diffuse_* = 1 below)
#  Known result (2026-07-27): velocity deficit at the flame front,
#  BOUNDED over 1000 steps (not growing): ~-26.5 cm/s vs the ~-1.8..-2
#  cm/s seen in the advection-only case - diffusion amplifies the same
#  splice-vs-Godunov composition-transport gap because the LES
#  conduction operator acts on the write-back's small EOS T-shift every
#  step. Coupling health at this config: species projection residual
#  ~1e-15 (machine precision), no NaN/blow-up over 1000 steps.
#  See memory: clem-diffusion-coupling.md.
# ============================================================

# ------------------  TIME / STEP CONTROL  -------------------
stop_time = 1.0
max_step  = 1000

# ------------------  GEOMETRY (quasi-1D)  -------------------
geometry.is_periodic = 0 1            # transverse periodic -> effectively 1D
geometry.coord_sys   = 0
geometry.prob_lo     =   0.0     0.0
geometry.prob_hi     =   0.8     0.0125
amr.n_cell           =   256     4

# ------------------  BOUNDARY CONDITIONS  -------------------
pelec.lo_bc       =  "Hard"     "Interior"
pelec.hi_bc       =  "FOExtrap" "Interior"

# ------------------  PHYSICS: Euler + full diffusion  ------
pelec.do_mol          = 1
pelec.do_hydro        = 1
pelec.diffuse_temp    = 1
pelec.diffuse_enth    = 1
pelec.diffuse_spec    = 1
pelec.diffuse_vel     = 1
pelec.flame_trac_name = HO2

# ------------------  TIME-STEP CONTROL  --------------------
pelec.cfl         = 0.25
pelec.init_shrink = 0.3
pelec.change_max  = 1.1
pelec.dt_cutoff   = 5.e-20

# ------------------  DIAGNOSTICS / VERBOSITY  --------------
pelec.sum_interval = 10
pelec.v            = 1
amr.v              = 1

# ------------------  REFINEMENT  ---------------------------
amr.max_level       = 0
amr.blocking_factor = 4
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2

# ------------------  CHECKPOINTS  --------------------------
amr.checkpoint_files_output = 0
amr.check_file              = chk
amr.check_int               = 5000

# ------------------  PLOTFILES  ---------------------------
amr.plot_int          = 250
amr.derive_plot_vars  = density xmom eden Temp pressure x_velocity
pelec.plot_rhoy       = 0
pelec.plot_massfrac   = 1

# ------------------  PROBLEM PARAMETERS  ------------------
prob.p_amb        = 1013250.0
prob.pmf_datafile = "LiDryer_H2_p1_phi0_4000tu0300.dat"
prob.x_flame      = 0.35

amrex.signal_handling = 0

# ------------------  CLEM (Fernando-Clem)  ------------------

# Fernando-Clem: clem.do_react=1 lazily constructs a
# pele::physics::reactions::ReactorCvode on first use (ReactionOperator::
# reactor(), ClemReaction.cpp) - its init() always reads ParmParse("cvode")
# regardless of pelec.chem_integrator/pelec.do_react (both off here), so
# these must be set even though the LES itself is not reacting

# ---- same in both runs ----
pelec.do_react        = 1        # CLEM: the line step sits in the reaction branch
pelec.chem_integrator = "ReactorCvode"
cvode.solve_type      = denseAJ_direct
pelec.mol_iters       = 1
amr.plot_file         = plt
pelec.track_extrema   = 1
