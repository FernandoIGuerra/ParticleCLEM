# ------------------  2D cellular detonation in 2H2 + O2 + 7Ar  ------------------
# The case of Hu, Zhang, Khoo & Jiang, Shock Waves (2004), at low resolution:
# stoichiometric H2/O2 with 70% Ar, 6.67 kPa, 298 K, a 9 mm channel with
# reflecting walls. The paper moves its grid with the wave; here the frame is
# the same idea: the window moves at D_window, so the fresh mixture enters at
# -D_window through x_hi and the burnt gas leaves through x_lo. x_velocity is in
# this frame: add D_window for the velocity in the tube.
# Start: the steady front of the 1-D run (Detonation1D/Long_amr2, plt13453, t = 360 us,
# from make_profile_1d.py) with random disturbances of the energy of the whole
# field, on both sides of the shock (prob.alpha). The paper perturbs only the first chemistry step.
# Euler equations, as the paper. The same inputs run CLEM (here) and pure PeleC
# (pure_pelec/): run from this folder, or set prob.profile. In 2D there is no LES,
# so the lines are not stirred.
# Compare: transverse waves from ~15 us; d/l = 0.56; D between about 1.43 and
# 0.77 D_CJ. Cell sizes depend on the mechanism (the paper uses 9 species, this
# is Davis) and dx here (0.375 mm) is only ~4.7 cells per induction length
# (1.77 mm): for finer runs set amr.n_cell, e.g. 320 48 (0.1875 mm).
max_step  = 100000000
stop_time = 2.0e-5            # 200 us

# PROBLEM SIZE & GEOMETRY: 6 cm x 9 mm, square cells
geometry.is_periodic = 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 6.0 2.0
amr.n_cell           = 160  24            # dx = dy = 0.375 mm

pelec.lo_bc = "FOExtrap" "NoSlipWall"       # burnt gas leaves; channel wall
pelec.hi_bc = "UserBC"   "NoSlipWall"       # fresh mixture enters; channel wall

# WHICH PHYSICS: Euler
pelec.do_hydro     = 1
pelec.do_mol       = 1        # CLEM: MOL with one iteration
pelec.mol_iters    = 1
pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0
pelec.diffuse_enth = 0
pelec.do_react     = 1        # required: the CLEM step sits in the reaction branch
pelec.chem_integrator = "ReactorCvode"
cvode.solve_type      = denseAJ_direct

# TIME STEP CONTROL
pelec.cfl         = 0.1
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 5.e-20

# DIAGNOSTICS & VERBOSITY
pelec.sum_interval = 100
pelec.v            = 1
amr.v              = 1
amr.data_log       = datlog_base1d

# REFINEMENT: only around the detonation front. The window moves with the
# wave, so the leading shock stays near x_shock = 4.5 cm; the band from 1.5 cm
# behind it (the induction zone, ~1.8 mm, the triple points and the transverse
# waves over about one cell length, ~1.5 cm) to 0.3 cm ahead of it is refined
# where the pressure or the temperature jumps between neighbouring cells. The
# burnt gas further behind stays on the base grid. Widen the band if the front
# drifts out of it (watch x of the shock in the plotfiles).
amr.max_level       = 1
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 8
amr.max_grid_size   = 16
amr.n_error_buf     = 4 4 4 4

tagging.refinement_indicators = front_p front_T
tagging.front_p.in_box_lo                   = 3.0 0.0
tagging.front_p.in_box_hi                   = 4.8 0.9
tagging.front_p.field_name                  = pressure
tagging.front_p.adjacent_difference_greater = 5.0e4    # dyn/cm2 (5 kPa ~ 0.75 p0): shock, Mach stem, transverse waves
tagging.front_p.max_level                   = 2
tagging.front_T.in_box_lo                   = 3.0 0.0
tagging.front_T.in_box_hi                   = 4.8 0.9
tagging.front_T.field_name                  = Temp
tagging.front_T.adjacent_difference_greater = 100.0    # K: the reaction front and the ignition behind the transverse waves
tagging.front_T.max_level                   = 2

# CHECKPOINT FILES: the lines have no restart yet
amr.checkpoint_files_output = 0

# PLOTFILES
amr.plot_files_output = 1
amr.plot_file         = Base1D/plt
amr.plot_per          = 10.0e-6
amr.plot_vars         = density Temp
amr.derive_plot_vars  = x_velocity y_velocity pressure MachNumber magvort eint_e
pelec.plot_massfrac   = 1
pelec.plot_rhoy       = 0

# PROBLEM PARAMETERS
prob.p0       = 6.67e4        # 6.67 kPa
prob.T0       = 298.0
prob.X_H2     = 2.0
prob.X_O2     = 1.0
prob.X_AR     = 7.0
prob.D_window = 1.5275e5      # plateau velocity of that 1-D run (0.945 D_CJ), so the front starts at rest in the window
prob.x_shock  = 4.5           # 1.5 cm of fresh mixture ahead
prob.alpha    = 0.3
prob.profile  = det1d_amr2_t360us.dat

eb2.geom_type = "all_regular"
amrex.signal_handling = 0
